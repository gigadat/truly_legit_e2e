# Active profile when you run plain `npm test` (npm run test:dev / test:qa set E2E_TARGET for you).
E2E_TARGET=local

# Portal base URL per target (no trailing slash). Required for dev/qa runs.
E2E_LOCAL_BASE_URL=http://localhost:8000
E2E_DEV_BASE_URL=https://dev-portal.trulylegit.com
E2E_QA_BASE_URL=https://qa-portal.trulylegit.com

# Optional: when E2E_TARGET=local and E2E_LOCAL_BASE_URL is empty, falls back to BASE_URL.
BASE_URL=http://localhost:8000

# Test users per target (leave blank to skip authenticated tests)
E2E_LOCAL_EMAIL=
E2E_LOCAL_PASSWORD=
E2E_DEV_EMAIL=
E2E_DEV_PASSWORD=
E2E_QA_EMAIL=
E2E_QA_PASSWORD=

# Fallback credentials if E2E_<TARGET>_EMAIL / _PASSWORD are unset
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Test-only usage API (drives sites.current_billing_cycle_sessions for persona tests).
# Endpoint must be guarded on the portal side (non-prod env + bearer token).
# Per-target overrides also supported: E2E_LOCAL_USAGE_API_URL, E2E_DEV_USAGE_API_TOKEN, etc.
E2E_USAGE_API_URL=
E2E_USAGE_API_TOKEN=

# Default merchant id used by persona-setup tests when not passed explicitly.
E2E_PERSONA_MERCHANT_ID=

# Visit threshold of the *target* lower tier (used to compute persona 1.0 vs 2.0 totals).
E2E_PERSONA_NEW_TIER_THRESHOLD=
